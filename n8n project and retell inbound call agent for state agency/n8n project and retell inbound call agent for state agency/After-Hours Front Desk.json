        "jsCode": "const call = $json.body.call;\n\nconst vars = call.collected_dynamic_variables || {};\n\nconst callerName = vars.caller_name || \"Unknown\";\nconst callerPhone = vars.caller_phone || \"\";\nconst callReason = vars.call_reason || \"property inquiry\";\n\n// Clean phone number\nconst cleanPhone = callerPhone.replace(/[^0-9+]/g, '');\nconst validPhone = cleanPhone.length >= 7 ? cleanPhone : null;\n\nreturn [{\n  json: {\n    caller_name: callerName,\n    caller_phone: validPhone,\n    call_reason: callReason,\n    call_id: call.call_id\n  }\n}];"
